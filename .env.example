PORT=3000

# Server-Side AI Provider API Keys
# Keys are accessed ONLY in Node.js backend environment (process.env).
# NEVER expose these in frontend code or bundle them into client assets.

# 1. Google Gemini (Used for GoogleProvider: gemini-1.5-flash)
# Get a key from: https://aistudio.google.com/
GEMINI_API_KEY=

# 2. Groq (Used for GroqProvider: llama-3.3-70b-versatile)
# Get a free fast key from: https://console.groq.com/
GROQ_API_KEY=

# 3. Cerebras (Used for CerebrasProvider: llama3.1-8b)
# Get an ultra-fast key from: https://cloud.cerebras.ai/
CEREBRAS_API_KEY=

# 4. OpenAI (Used for OpenAIProvider: gpt-4o-mini)
# Get a key from: https://platform.openai.com/
OPENAI_API_KEY=

# 5. Anthropic (Used for AnthropicProvider: claude-3-5-haiku-latest)
# Get a key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Synthesis Engine Provider (Optional)
# Specify which configured provider generates LUMIQ'S TAKE:
# Options: gemini | groq | cerebras | openai | anthropic
# If empty, LUMIQ defaults to the first available configured provider.
SYNTHESIS_PROVIDER=gemini
